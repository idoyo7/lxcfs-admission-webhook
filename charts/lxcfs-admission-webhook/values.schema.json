{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lxcfs-admission-webhook values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the fully qualified app name"
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentName": {
          "type": "string",
          "minLength": 1,
          "description": "Component suffix used to name webhook resources: {release}-{componentName}"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "affinity": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "lxcfs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentName": {
          "type": "string",
          "minLength": 1,
          "description": "Component suffix used to name the LXCFS DaemonSet: {release}-{componentName}"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Args passed to the lxcfs binary; override to opt into new flags in 7.x+ without rebuilding the image"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" },
        "hostPath": { "type": "string" },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 20,
          "description": "Grace period for the LXCFS DaemonSet Pod. The preStop teardown budget is derived from it as max(5, value - 15)s; below 20 the FUSE teardown cannot fit its mandatory probe/abort/lazy-detach rungs"
        },
        "podAnnotations": { "type": "object" },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "affinity": { "type": "object" },
        "nodeSelector": { "type": "object" }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration": { "type": "string" },
            "privateKey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "algorithm": { "type": "string" },
                "size": { "type": "integer" }
              }
            }
          }
        },
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration": { "type": "string" },
            "renewBefore": { "type": "string" },
            "privateKey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "algorithm": { "type": "string" },
                "size": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "mutatingWebhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failurePolicy": {
          "type": "string",
          "enum": ["Ignore", "Fail"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "sideEffects": {
          "type": "string",
          "enum": ["None", "NoneOnDryRun", "Some", "Unknown"]
        },
        "reinvocationPolicy": {
          "type": "string",
          "enum": ["Never", "IfNeeded"]
        },
        "namespaceSelector": { "type": "object" },
        "objectSelector": { "type": "object" }
      }
    }
  }
}
