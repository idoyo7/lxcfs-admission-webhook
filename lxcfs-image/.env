# see LXCFS_VERSION at https://github.com/lxc/lxcfs/releases
LXCFS_VERSION=7.0.0

# Image build revision for the LXCFS version above. Bump this (not
# LXCFS_VERSION) whenever the image itself changes without upstream moving
# -- a different base image, an added or dropped patch in patches/, a
# change to entrypoint.sh or lxcfs-mount.sh.
#
# The published tag is ${LXCFS_VERSION}-${LXCFS_IMAGE_REVISION}, so every
# build gets an immutable handle. Reset to 1 when LXCFS_VERSION changes.
#
# Revision history:
#   7.0.0-1  glibc (debian:bookworm-slim) base + patches/0001; supersedes
#            the alpine:3.22 musl build published as plain `7.0.0`, which
#            hangs on every cpuview-backed file.
#            https://github.com/lxc/lxcfs/issues/730
#   7.0.0-2  adds busybox-static (+1.8 MiB on arm64, +1.9 MiB on amd64),
#            staged by entrypoint.sh at /var/lib/lxc/script/busybox so
#            lxcfs-mount.sh can mount and unmount inside containers whose
#            image ships no mount/umount -- distroless and Alpine alike.
#            0.4.0 skipped those containers in silence. Chart 0.4.1.
#   7.0.0-3  makes the postStart hook immune to the fact that kubelet runs
#            it concurrently with this image's ENTRYPOINT. entrypoint.sh
#            stages lxcfs-mount.sh with rename(2) instead of rewriting it
#            in place, and the new lxcfs-ready.sh gates the hook on the
#            canonical mount actually answering a read. Without both, the
#            hook ran the PREVIOUS release's script -- or a splice of the
#            two -- so 7.0.0-2's own fix did not take effect on the roll
#            that deployed it. Also: containers the webhook never injected
#            into are reported as skips instead of warnings, and the
#            DaemonSet gets a readinessProbe that reads through the mount.
#            Chart 0.4.2.
LXCFS_IMAGE_REVISION=3
