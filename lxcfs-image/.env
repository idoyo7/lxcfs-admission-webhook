# see LXCFS_VERSION at https://github.com/lxc/lxcfs/releases
LXCFS_VERSION=7.0.0

# Image build revision for the LXCFS version above. Bump this (not
# LXCFS_VERSION) whenever the image itself changes without upstream moving
# -- a different base image, an added or dropped patch in patches/, a
# change to entrypoint.sh or lxcfs-mount.sh.
#
# The published tag is ${LXCFS_VERSION}-${LXCFS_IMAGE_REVISION}, so every
# build gets an immutable handle. Reset to 1 when LXCFS_VERSION changes.
#
# Revision history:
#   7.0.0-1  glibc (debian:bookworm-slim) base + patches/0001; supersedes
#            the alpine:3.22 musl build published as plain `7.0.0`, which
#            hangs on every cpuview-backed file.
#            https://github.com/lxc/lxcfs/issues/730
LXCFS_IMAGE_REVISION=1
